{var $en = $locale === 'en'}
<section id="kontakt" class="section section-tint">
	<div class="container-xl">
		<div class="row g-5 align-items-center">
			<div class="col-lg-5">
				<p class="eyebrow">{$en ? 'Contact' : 'Kontakt'}</p>
				<h2 n:tag="$h ?? 'h2'" class="section-title">{$en ? 'Book an appointment' : 'Objednejte se'}</h2>
				<ul class="contact-list">
					<li>
						<i class="bi bi-telephone"></i>
						<div>
							<span class="contact-label">{$en ? 'Phone' : 'Telefon'}</span>
							<a href="tel:{str_replace(' ', '', $phone)}">{$phone}</a>
						</div>
					</li>
					<li>
						<i class="bi bi-envelope"></i>
						<div>
							<span class="contact-label">E-mail</span>
							<a href="mailto:{$email}">{$email}</a>
						</div>
					</li>
					<li>
						<i class="bi bi-geo-alt"></i>
						<div>
							<span class="contact-label">{$en ? 'Address' : 'Adresa'}</span>
							<span>{$address}</span>
						</div>
					</li>
				</ul>
			</div>
			<div class="col-lg-7">
				<div class="map-wrap">
					<iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2560.3146583372213!2d14.423574876292154!3d50.08039537152393!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x470b94ed56725b13%3A0x6bb6bf3fca1fa0b5!2zxaB0xJtww6Fuc2vDoSA1NSwgMTEwIDAwIE5vdsOpIE3Em3N0bw!5e0!3m2!1scs!2scz!4v1690061175902!5m2!1scs!2scz"
							title="{$en ? 'Map' : 'Mapa'}"
							allowfullscreen=""
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade">
					</iframe>
				</div>
			</div>
		</div>
	</div>
</section>
