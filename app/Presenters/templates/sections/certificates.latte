{var $en = $locale === 'en'}
<section id="certifikaty" class="section section-white section-pattern">
	<div class="container-xl">
		<p class="eyebrow">{$en ? 'Education' : 'Vzdělání'}</p>
		<h2 n:tag="$h ?? 'h2'" class="section-title">{$en ? 'Diplomas and certifications' : 'Diplomy a certifikáty'}</h2>
		<div class="cert-grid">
			<a n:for="$i = 1; $i <= 9; $i++" href="{$basePath}/img/cert/{sprintf('%03d', $i)}.jpg" class="cert-item wow fadeInUp" data-wow-delay="{($i - 1) % 3 * 0.1}s">
				<img src="{$basePath}/img/cert/thumb/{sprintf('%03d', $i)}.jpg" alt="{$en ? 'Certificate' : 'Certifikát'} {$i}" loading="lazy">
				<span class="cert-zoom"><i class="bi bi-arrows-angle-expand"></i></span>
			</a>
		</div>
	</div>
</section>

<dialog class="lightbox" id="certLightbox" aria-label="{$en ? 'Certificate preview' : 'Náhled certifikátu'}">
	<button type="button" class="lightbox-btn lightbox-close" data-lightbox="close" aria-label="{$en ? 'Close' : 'Zavřít'}"><i class="bi bi-x"></i></button>
	<button type="button" class="lightbox-btn lightbox-prev" data-lightbox="prev" aria-label="{$en ? 'Previous' : 'Předchozí'}"><i class="bi bi-chevron-left"></i></button>
	<img src="" alt="">
	<button type="button" class="lightbox-btn lightbox-next" data-lightbox="next" aria-label="{$en ? 'Next' : 'Další'}"><i class="bi bi-chevron-right"></i></button>
</dialog>
