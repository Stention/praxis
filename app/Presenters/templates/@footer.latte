{block footer}
	{var $en = $locale === 'en'}
	<!-- Footer Start -->
	<footer class="site-footer">
		<div class="container-xl">
			<div class="row g-5">
				<div class="col-lg-5">
					<div class="brand brand-light">
						<i class="fa fa-tooth brand-icon"></i>
						<span>
							<span class="brand-name">{$praxisName}</span>
							<span class="brand-sub">MDDr. Eliška Kremlová</span>
						</span>
					</div>
					<p class="footer-text mt-3">
						{$en ? 'Dental practice in the centre of Prague.' : 'Zubní ordinace v centru Prahy.'}
					</p>
					<div class="footer-social">
						<a href="https://www.facebook.com/profile.php?id=61558020702903" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
						<a href="https://www.instagram.com/zubarka_eliska/" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
					</div>
				</div>
				<div class="col-sm-6 col-lg-3">
					<h3 class="footer-title">{$en ? 'Navigation' : 'Navigace'}</h3>
					<ul class="footer-links">
						<li><a href="{link Home:default, locale: $locale}#sluzby">{$en ? 'Services' : 'Služby'}</a></li>
						<li><a href="{link Home:default, locale: $locale}#hodiny">{$en ? 'Office hours' : 'Ordinační hodiny'}</a></li>
						<li><a href="{link Home:default, locale: $locale}#cenik">{$en ? 'Pricing' : 'Ceník'}</a></li>
						<li><a href="{link Home:default, locale: $locale}#certifikaty">{$en ? 'Diplomas and certificates' : 'Diplomy a certifikáty'}</a></li>
					</ul>
				</div>
				<div class="col-sm-6 col-lg-4">
					<h3 class="footer-title">{$en ? 'Contact' : 'Kontakt'}</h3>
					<ul class="footer-links">
						<li><a href="tel:{str_replace(' ', '', $phone)}">{$phone}</a></li>
						<li><a href="mailto:{$email}">{$email}</a></li>
						<li>{$address}</li>
					</ul>
				</div>
			</div>
			<div class="footer-bottom">
				<span>&copy; {date('Y')} {$praxisName}</span>
				<a href="{$basePath}/files/gdpr.pdf" target="_blank" rel="noopener noreferrer">
					{$en ? 'Privacy Policy (in Czech)' : 'Zásady zpracování osobních údajů'}
				</a>
			</div>
		</div>
	</footer>
	<!-- Footer End -->
{/block}
