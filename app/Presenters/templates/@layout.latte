{import '@holidayInfoBar.latte'}
{import '@footer.latte'}
{varType bool $cookiesAccepted}
{varType string $locale}
{var $en = $locale === 'en'}

<!DOCTYPE html>
<html lang="{if $en}en{else}cs{/if}">

<head>
	<meta charset="utf-8">
	<title>{$title}</title>
	<meta name="description" content="{$metaDescription}">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">

	<!-- Favicon -->
	<link href="{$basePath}/img/icon.png" rel="icon">

	<!-- Google Web Fonts -->
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet">

	<!-- Icon Font Stylesheet -->
	<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
	<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

	<!-- Libraries Stylesheet -->
	<link href="{$basePath}/lib/animate/animate.min.css" rel="stylesheet">

	<!-- Customized Bootstrap Stylesheet -->
	<link href="{$basePath}/css/bootstrap.min.css" rel="stylesheet">

	<link href="{$basePath}/utils/cookie_consent/cookieconsent-3.1.0/dist/cookieconsent.css" rel="stylesheet">
	<link href="{$basePath}/css/style.css" rel="stylesheet">

	<link rel="canonical" href="{$canonicalUrl}">
	<link rel="alternate" hreflang="cs" href="{$hreflangCs}" />
	<link rel="alternate" hreflang="en" href="{$hreflangEn}" />
	<link rel="alternate" hreflang="x-default" href="{$hreflangCs}" />

</head>

<body>

<div id="fb-root"></div>
<script async defer crossorigin="anonymous" src="https://connect.facebook.net/cs_CZ/sdk.js#xfbml=1&version=v22.0"></script>

<!-- Header Start -->
<header class="site-header">
	<nav class="navbar navbar-expand-lg container-xl">
		<a n:href="Home:default, locale: $locale" class="brand">
			<i class="fa fa-tooth brand-icon"></i>
			<span>
				<span class="brand-name">{$praxisName}</span>
				<span class="brand-sub">MDDr. Eliška Kremlová</span>
			</span>
		</a>
		<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse" aria-label="Menu">
			<i class="bi bi-list"></i>
		</button>
		<div class="collapse navbar-collapse" id="navbarCollapse">
			<div class="navbar-nav ms-auto">
				<a href="{link Home:default, locale: $locale}#sluzby" class="nav-link">{$en ? 'Services' : 'Služby'}</a>
				<a href="{link Home:default, locale: $locale}#deti" class="nav-link">{$en ? 'Children' : 'Děti'}</a>
				<a href="{link Home:default, locale: $locale}#hodiny" class="nav-link">{$en ? 'Office hours' : 'Ordinační hodiny'}</a>
				<a href="{link Home:default, locale: $locale}#cenik" class="nav-link">{$en ? 'Pricing' : 'Ceník'}</a>
				<a href="{link Home:default, locale: $locale}#pojistovny" class="nav-link">{$en ? 'Insurance' : 'Pojišťovny'}</a>
				<a href="{link Home:default, locale: $locale}#kontakt" class="nav-link">{$en ? 'Contact' : 'Kontakt'}</a>
			</div>
			<div class="header-actions">
				<a n:href="$presenter->getName() . ':default', locale: $en ? 'cs' : 'en'" class="lang-switch">{$en ? 'CZ' : 'EN'}</a>
				<a href="tel:{str_replace(' ', '', $phone)}" class="btn-brand btn-sm-brand"><i class="bi bi-telephone"></i>{$phone}</a>
			</div>
		</div>
	</nav>
</header>
<!-- Header End -->

{*	<div class="notice-bar">*}
{*		{if $en}*}
{*			Due to illness, we are currently not providing consultations. We apologize to all patients,*}
{*			and will contact you with new appointment dates as soon as possible after returning to the clinic.*}
{*		{else}*}
{*			Z důvodu nemoci neordinujeme. Všem pacientům se omlouváme,*}
{*			budeme vás kontaktovat s novými termíny co nejdříve po návratu do ordinace.*}
{*		{/if}*}
{*	</div>*}

{*{include holidayInfoBar}*}

<main>
	{include content}
</main>

{include footer}

<script src="{$basePath}/assets/js/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>

<!-- JavaScript Libraries -->
<script src="{$basePath}/lib/wow/wow.min.js"></script>

<!-- Template Javascript -->
<script src="{$basePath}/js/main.js"></script>

<script src="{$basePath}/utils/cookie_consent/cookieconsent-3.1.0/dist/cookieconsent.umd.js"></script>
<script>
	const language = {$locale};
</script>
<script type="module" src="{$basePath}/utils/cookie_consent/cookieconsent-config.js"></script>

</body>

</html>
