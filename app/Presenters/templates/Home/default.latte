{varType string $praxisName}
{varType array $priceList}
{varType array $clinicHours}
{varType string $email}
{varType string $phone}
{varType string $address}
{varType string $locale}
{var $title = $title}
{var $metaDescription = $metaDescription}


{block content}
	<div class="notice-bar">
		<div class="container-xl notice-inner">
			<i class="bi bi-person-plus notice-icon"></i>
			<div>
				<p class="notice-title">{$locale === 'en' ? 'We are currently accepting new patients.' : 'Aktuálně přijímáme nové pacienty.'}</p>
				<p class="notice-text">
					{$locale === 'en' ? 'Book by phone:' : 'Objednejte se telefonicky:'}
					<a href="tel:{str_replace(' ', '', $phone)}">{$phone}</a>
				</p>
			</div>
		</div>
	</div>
	{include '../sections/hero.latte'}
	{include '../sections/services.latte'}
	{include '../sections/children.latte'}
	{include '../sections/hours.latte'}
	{include '../sections/prices.latte'}
	{include '../sections/insurance.latte'}
	{include '../sections/certificates.latte'}
	{include '../sections/contact.latte'}
{/block}
